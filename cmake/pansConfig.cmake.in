# pans 包配置模板：由 configure_package_config_file 生成 pansConfig.cmake，
#   供使用方通过 find_package(pans CONFIG) 加载。
# @PACKAGE_INIT@：生成时被替换为 PACKAGE_PREFIX_DIR 的计算逻辑以及 set_and_check / check_required_components 等辅助宏，
#   使安装目录整体移动后路径仍然正确。
@PACKAGE_INIT@

# CMakeFindDependencyMacro：提供 find_dependency 宏。
# find_dependency(...)：参数同 find_package，但会自动继承使用方 find_package(pans) 的 QUIET/REQUIRED，
#   找不到时设置 pans_FOUND 为 FALSE 并 return()，让使用方得到正常的"未找到"结果而不是直接报错终止。
include(CMakeFindDependencyMacro)

find_dependency(Threads)

# Linux 需要 libdw 做调用栈符号化；macOS 使用 libSystem 自带的 backtrace/dladdr，无需额外查找。
# 不用 pkg_check_modules 的 REQUIRED：它找不到时会直接 FATAL_ERROR，
#   改为手动设置 pans_FOUND / pans_NOT_FOUND_MESSAGE 并 return()，与 find_dependency 的行为保持一致。
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_dependency(PkgConfig)
    pkg_check_modules(PANS_LIBDW QUIET IMPORTED_TARGET libdw)
    if(NOT PANS_LIBDW_FOUND)
        set(pans_FOUND FALSE)
        set(pans_NOT_FOUND_MESSAGE "pans requires libdw (elfutils), which was not found via pkg-config.")
        return()
    endif()
endif()

# 第三方库随 pans 一起安装在同一前缀下（见 pansDependencies.cmake 的 install(DIRECTORY ...)）。
# PACKAGE_PREFIX_DIR：由 @PACKAGE_INIT@ 计算出的安装前缀。
# PATHS ... NO_DEFAULT_PATH：只在 pans 的安装前缀中查找，避免误用系统或 Homebrew 中的同名库。
# 顺序有讲究：protobuf 的配置文件内部会再次查找 absl、ZLIB、utf8_range 但不限定路径；
#   这里先按指定路径找到并记下 <包名>_DIR，protobuf 再查找时会复用同一份，不会混入系统版本。
find_dependency(absl CONFIG PATHS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH)
# COMPONENTS static：zlib 的配置文件按组件加载，static 组件只导入静态库目标 ZLIB::ZLIBSTATIC。
find_dependency(ZLIB CONFIG COMPONENTS static PATHS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH)

# 很多库（包括 protobuf）链接的是 ZLIB::ZLIB，而只加载 static 组件时不存在该目标，
#   因此创建一个转发到 ZLIB::ZLIBSTATIC 的接口目标。
# INTERFACE_LINK_LIBRARIES：链接本目标时会一并链接其中列出的目标。
if(TARGET ZLIB::ZLIBSTATIC AND NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB INTERFACE IMPORTED)
    set_target_properties(ZLIB::ZLIB PROPERTIES INTERFACE_LINK_LIBRARIES ZLIB::ZLIBSTATIC)
endif()

# utf8_range：protobuf 依赖的 UTF-8 校验库，由 protobuf 一并安装。
find_dependency(utf8_range CONFIG PATHS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH)
find_dependency(protobuf CONFIG PATHS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH)
find_dependency(yaml-cpp CONFIG PATHS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH)
# tinyxml2 的 static 与 shared 组件互斥，这里只加载静态库目标。
find_dependency(tinyxml2 CONFIG COMPONENTS static PATHS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH)
find_dependency(kcp CONFIG PATHS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH)

# rapidjson 是纯头文件库，没有安装配置文件，头文件随 pans 装在 <前缀>/include/rapidjson 下。
# 这里不加 GLOBAL：导入目标只在调用 find_package(pans) 的目录及其子目录中可见。
if(NOT TARGET rapidjson::rapidjson)
    add_library(rapidjson::rapidjson INTERFACE IMPORTED)
    set_target_properties(rapidjson::rapidjson PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
    )
endif()

# CMAKE_CURRENT_LIST_DIR：当前正在执行的 .cmake 文件所在目录，即 pansConfig.cmake 的安装位置。
# pansTargets.cmake 由 install(EXPORT pansTargets ...) 生成，定义 pans、pans_options 的导入目标；
#   依赖必须在它之前找到，因为 pans 链接的第三方目标（absl::、protobuf:: 等）会在其中被引用。
include("${CMAKE_CURRENT_LIST_DIR}/pansTargets.cmake")

# check_required_components(pans)：校验使用方 find_package(pans COMPONENTS ...) 请求的组件是否都已找到，
#   未找到时将 pans_FOUND 置为 FALSE。
check_required_components(pans)
